# NOTE: keep minimal — the stock vendor/etc/init/hw/init.mt6893.rc already
# handles mount_all --early/--late, the /mnt/vendor partition ownership,
# page-cluster/zram (via /vendor/bin/swap_enable.sh) and most stune tuning.

on early-init
    # Mount debugfs (stock only mounts it on eng/userdebug builds)
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug

on fs
    # Storage mountpoints (fs_mgr normally creates these on mount; kept as
    # insurance so restorecon below always has real dirs)
    mkdir /mnt/vendor/protect_f 0771 system system
    mkdir /mnt/vendor/protect_s 0771 system system
    mkdir /mnt/vendor/nvdata 0771 system system
    mkdir /mnt/vendor/nvcfg 0771 system system
    mkdir /mnt/vendor/persist 0771 system system

    # Restorecon (stock only restores nvdata and nvcfg)
    restorecon_recursive /mnt/vendor/protect_f
    restorecon_recursive /mnt/vendor/protect_s

on post-fs-data
    # NVData (stock only creates /data/vendor_de/meta)
    mkdir /data/vendor_de 0771 system system
    mkdir /data/vendor_de/0 0771 system system

    # CCCI (modem)
    mkdir /data/vendor/ccci_cfg 0771 system system

on property:sys.boot_completed=1
    # Scheduler tuning (stock only tunes schedtune.window_policy)
    write /dev/stune/foreground/schedtune.prefer_idle 1
    write /dev/stune/top-app/schedtune.boost 10
    write /dev/stune/top-app/schedtune.prefer_idle 1
