# Block devices
/dev/block/platform/bootdevice(/.*)?    u:object_r:boot_block_device:s0

# MTK specific nodes
/dev/wmtWifi                            u:object_r:wifi_device:s0
/dev/stpbt                              u:object_r:hci_attach_dev:s0
/dev/stpgps                             u:object_r:gps_device:s0
/dev/stpwmt                             u:object_r:stpwmt_device:s0
/dev/mali[0-9]*                         u:object_r:gpu_device:s0
/dev/mtk_disp_mgr                       u:object_r:graphics_device:s0
/dev/mtkfb_vsync                        u:object_r:graphics_device:s0
/dev/mtk_thermal                        u:object_r:thermal_device:s0
/dev/ccci[0-9]*                         u:object_r:rild_device:s0
/dev/ttyC[0-9]*                         u:object_r:rild_device:s0

# Fingerprint
/dev/goodix_fp                          u:object_r:fingerprint_device:s0

# Vendor binaries
/vendor/bin/hw/android\.hardware\.boot@1\.0-service  u:object_r:hal_bootctl_default_exec:s0

# Biometrics
/system/bin/hw/android\.hardware\.biometrics\.fingerprint@2\.3-service\.karen u:object_r:hal_fingerprint_karen_exec:s0

/sys/kernel/oplus_display/oplus_notify_fppress     u:object_r:sysfs_fingerprint_notify:s0

/sys/kernel/oplus_display/dimlayer_bl_en           u:object_r:sysfs_fod:s0

# KPOC
/system/bin/kpoc_charger        u:object_r:kpoc_charger_exec:s0

# Light Hal
/(product|system/product)/vendor_overlay/[0-9]+/bin/hw/android\.hardware\.lights-service\.mediatek u:object_r:hal_light_default_exec:s0

# MTD
/dev/block/mtd(.*)?             u:object_r:mtd_device:s0
/dev/block/mntlblk(.*)?         u:object_r:mtd_device:s0
/dev/ubi_ctrl                   u:object_r:mtd_device:s0
/dev/ubi[_0-9]*                 u:object_r:mtd_device:s0

# RTC
/dev/rtc[0-9]+                  u:object_r:rtc_device:s0

# Touch
/system/bin/hw/vendor\.lineage\.touch@[0-9]\.[0-9]-service\.karen u:object_r:hal_lineage_touch_default_exec:s0

# Vendor overlay
/(product|system/product)/vendor_overlay/[0-9]+/etc(/.*)?      u:object_r:vendor_configs_file:s0
/(product|system/product)/vendor_overlay/[0-9]+/lib(64)?/hw    u:object_r:vendor_hal_file:s0

# VoLTE
/system/bin/vtservice           u:object_r:vtservice_exec:s0

# Alert slider
/(system_ext|system/system_ext)/bin/alert-slider_daemon    u:object_r:alert-slider_daemon_exec:s0

# V4A Drivers
/odm/etc/audio_effects.xml      u:object_r:vendor_configs_file:s0
