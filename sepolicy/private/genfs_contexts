# MTK specific procfs entries
genfscon proc /bootdevice             u:object_r:proc_cmdline:s0
genfscon proc /mtk_lpm                u:object_r:proc_mtk_lpm:s0
genfscon proc /touchpanel             u:object_r:proc_touchpanel:s0
genfscon sysfs /bus/platform/devices/bootdevice  u:object_r:sysfs_block_device:s0

# MTK tristatekey
genfscon proc /tristatekey  u:object_r:proc_tristatekey:s0

# Vibration (sysfs paths are relative to the mount point)
genfscon sysfs /class/leds/vibrator/vmax         u:object_r:sysfs_vibrator:s0

# NOTE: battery / charger / vbus / cpufreq / gpufreq / ppm / ged labels are
# owned by device/mediatek/sepolicy_vndr (basic/non_plat, basic/plat_private
# and bsp genfs_contexts); the source tree's duplicate labels were not merged.
